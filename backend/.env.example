# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email Cấu hình nhận thông báo đơn hàng
ADMIN_NOTIFICATION_EMAIL=admin@sale-ai.vn
DEFAULT_FROM_EMAIL=noreply@sale-ai.vn

# Email Backend: Để mặc định console sẽ in chi tiết email ra terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Cấu hình gửi qua Gmail thật (khi cần dùng):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=youremail@gmail.com
# EMAIL_HOST_PASSWORD=your-google-app-password
